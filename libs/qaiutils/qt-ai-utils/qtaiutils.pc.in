prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/qt-ai-utils

Name: qaiutils
Description: Jobs Qt boiler plate library for JOB(Joseph's Odd Builder) framework
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lQt6Core -lQt6Concurrent -lQt6Network -lqaiutils
Cflags: -I${includedir}
Requires: Qt6Core Qt6Concurrent Qt6Network
