prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/job_schema

Name: job_schema
Description: Schema library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Requires: yaml-cpp job_core job_threads job_io
Libs: -L${libdir} -ljob_schema
Cflags: -I${includedir}
