prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/job_gui

Name: job_gui
Description: Gui'ish library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Requires: job_core job_io job_threads job_render harfbuzz freetype2
Libs: -L${libdir} -ljob_gui
Cflags: -I${includedir}
