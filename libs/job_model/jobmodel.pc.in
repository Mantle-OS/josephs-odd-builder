prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/jobmodel

Name: jobmodel
Description: Model library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ljobtoken -ljobthreads -ljobcore -lpthread -latomic -ljobggml -ljobmodel
Cflags: -I${includedir}
