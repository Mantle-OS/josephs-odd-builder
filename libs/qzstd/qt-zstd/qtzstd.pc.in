prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/qt-zstd

Name: qtzstd
Description: JobZstd bindings for Qt in the framework (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lsodium -Qt6Core -ljobcrypto -lqsodium -qtzstd
Cflags: -I${includedir}
Requires: sodium Qt6Core jobcrypto qsodium
