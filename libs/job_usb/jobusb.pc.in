prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/job_usb

Name: job_usb
Description: USB library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Requires: libusb-1.0 libudev job_core job_io job_threads
Libs: -L${libdir} -ljob_usb
Cflags: -I${includedir}
