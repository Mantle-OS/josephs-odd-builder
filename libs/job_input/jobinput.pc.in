prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/job_input

Name: job_input
Description: Events and Input library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Requires: job_core job_io job_threads
Libs: -L${libdir} -ljob_input
Cflags: -I${includedir}
