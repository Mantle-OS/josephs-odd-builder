prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/job_damage

Name: job_damage
Description: Damage library for JOB (Joseph's Odd Builder)
Version: @PROJECT_VERSION@
Requires: job_core job_io job_threads
Libs: -L${libdir} -ljob_damage
Cflags: -I${includedir}
